<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- Auto = built-in articles plus posts written in the admin (Blog in /admin). Json = built-in articles only. Sql = legacy dbo.BlogPosts via YenetchDb. -->
    <add key="BlogSource" value="Auto" />
    <!-- Database = all website content from the CMS tables, edited in /admin/content (filled from assets/data on first run).
         Files = read assets/data/*.json directly (the site also falls back to these if the database cannot be reached). -->
    <add key="ContentSource" value="Database" />
    <!-- New-lead alerts go here. Leave blank to only store leads in the CRM. -->
    <add key="LeadEmailTo" value="leads@yenetch.com" />
    <!-- Sender for lead alerts and newsletters. Must be an address your SMTP server may send as. -->
    <add key="MailFrom" value="hello@yenetch.com" />
    <!-- One-time key to create the first admin at /admin/setup. Change it before deploying; it stops working once a user exists. -->
    <add key="AdminSetupKey" value="5nOMNx8k6kvv98hUU-SvIWuj" />
    <!-- Optional: ipinfo.io token for city-level visitor location (free tier: 50k lookups a month). Not needed behind Cloudflare. -->
    <add key="GeoIpToken" value="" />
    <!-- true only when the site sits behind a proxy or load balancer that sets X-Forwarded-For. -->
    <add key="TrustForwardedFor" value="false" />
    <!-- Website analytics older than this are deleted daily. Keep in step with the privacy policy. -->
    <add key="AnalyticsRetentionMonths" value="25" />
    <add key="SiteUrl" value="https://www.yenetch.com" />
    <!-- true = browsers also load full-resolution stock photos from the Unsplash CDN (local 400px copies are the fallback). -->
    <add key="StockCdn" value="true" />
  </appSettings>
  <connectionStrings>
    <add name="YenetchDb" connectionString="Data Source=.;Initial Catalog=Yenetch;Integrated Security=True" providerName="System.Data.SqlClient" />
    <!-- CRM, analytics and newsletter tables. The tables are created on first run. With LocalDB (Visual Studio) the
         Yenetch database is created too; on a production SQL Server create an empty database first if the app login
         cannot create databases, then point this at it. -->
    <add name="CrmDb" connectionString="Data Source=(LocalDB)\MSSQLLocalDB;Initial Catalog=Yenetch;Integrated Security=True;MultipleActiveResultSets=False" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" enableVersionHeader="false" />
    <!-- Cookies cannot be read by scripts and are not sent with requests from other websites. Release builds also require HTTPS (Web.Release.config). -->
    <httpCookies httpOnlyCookies="true" requireSSL="false" sameSite="Lax" />
    <globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" />
    <pages controlRenderingCompatibilityVersion="4.0" clientIDMode="Static" />
    <authentication mode="Forms">
      <forms name=".YNADMIN" loginUrl="~/admin/login" defaultUrl="~/admin" timeout="720" slidingExpiration="true" requireSSL="false" cookieless="UseCookies" protection="All" path="/" />
    </authentication>
    <customErrors mode="RemoteOnly" defaultRedirect="~/NotFound.aspx">
      <error statusCode="404" redirect="~/NotFound.aspx" />
    </customErrors>
  </system.web>
  <!-- Admin area: signed-in users only, except the sign-in and first-run pages. -->
  <location path="admin">
    <system.web><authorization><deny users="?" /></authorization></system.web>
  </location>
  <location path="admin/login">
    <system.web><authorization><allow users="*" /></authorization></system.web>
  </location>
  <location path="admin/setup">
    <system.web><authorization><allow users="*" /></authorization></system.web>
  </location>
  <location path="Admin/Login.aspx">
    <system.web><authorization><allow users="*" /></authorization></system.web>
  </location>
  <location path="Admin/Setup.aspx">
    <system.web><authorization><allow users="*" /></authorization></system.web>
  </location>
  <location path="admin/verify">
    <system.web><authorization><allow users="*" /></authorization></system.web>
  </location>
  <location path="Admin/Verify.aspx">
    <system.web><authorization><allow users="*" /></authorization></system.web>
  </location>
  <!-- The contact form accepts one attached file up to 5 MB. -->
  <location path="contact">
    <system.web><httpRuntime maxRequestLength="7168" /></system.web>
    <system.webServer><security><requestFiltering><requestLimits maxAllowedContentLength="7340032" /></requestFiltering></security></system.webServer>
  </location>
  <!-- Job applications with a CV (PDF or Word, up to 5 MB). -->
  <location path="api/apply">
    <system.web><httpRuntime maxRequestLength="7168" /></system.web>
    <system.webServer><security><requestFiltering><requestLimits maxAllowedContentLength="7340032" /></requestFiltering></security></system.webServer>
  </location>
  <!-- Image uploads (JPG, PNG, WebP or GIF, up to 8 MB, plus the smaller WebP copies the browser makes). -->
  <location path="Admin/Upload.ashx">
    <system.web><httpRuntime maxRequestLength="30720" /></system.web>
    <system.webServer><security><requestFiltering><requestLimits maxAllowedContentLength="31457280" /></requestFiltering></security></system.webServer>
  </location>
  <system.net>
    <!-- Until SMTP is set up, email is saved as .eml files in App_Data/mail (open them in Outlook or Mail to check).
         To send for real, replace with for example:
         <smtp deliveryMethod="Network" from="leads@yenetch.com">
           <network host="smtp.office365.com" port="587" enableSsl="true" userName="leads@yenetch.com" password="..." />
         </smtp> -->
    <mailSettings>
      <smtp deliveryMethod="SpecifiedPickupDirectory" from="leads@yenetch.com" />
    </mailSettings>
  </system.net>
  <system.webServer>
    <modules runAllManagedModulesForAllRequests="false">
      <remove name="UrlRoutingModule-4.0" />
      <add name="UrlRoutingModule-4.0" type="System.Web.Routing.UrlRoutingModule" preCondition="" />
    </modules>
    <handlers>
      <add name="Sitemap" path="sitemap.xml" verb="GET" type="Yenetch.Web.Handlers.SitemapHandler" preCondition="integratedMode" />
      <add name="Robots" path="robots.txt" verb="GET" type="Yenetch.Web.Handlers.RobotsHandler" preCondition="integratedMode" />
    </handlers>
    <security>
      <requestFiltering>
        <!-- Methods the site never uses. -->
        <verbs><add verb="TRACE" allowed="false" /><add verb="TRACK" allowed="false" /></verbs>
        <!-- Folders and files that must never be served. -->
        <hiddenSegments><add segment=".git" /></hiddenSegments>
        <fileExtensions><add fileExtension=".sql" allowed="false" /><add fileExtension=".bak" allowed="false" /><add fileExtension=".log" allowed="false" /></fileExtensions>
      </requestFiltering>
    </security>
    <httpErrors errorMode="DetailedLocalOnly" existingResponse="Auto">
      <remove statusCode="404" />
      <error statusCode="404" path="/NotFound.aspx" responseMode="ExecuteURL" />
    </httpErrors>
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
    </staticContent>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=(), payment=(self &quot;https://checkout.razorpay.com&quot;)" />
        <!-- Baseline content security policy: no framing by other sites, no plugins, forms post only here, base URL fixed.
             Scripts are not restricted here because admin-added tracking codes (Analytics, Pixel, Tag Manager) need them. -->
        <add name="Content-Security-Policy" value="frame-ancestors 'self'; base-uri 'self'; object-src 'none'; form-action 'self'" />
        <add name="Cross-Origin-Opener-Policy" value="same-origin-allow-popups" />
        <add name="X-Permitted-Cross-Domain-Policies" value="none" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
